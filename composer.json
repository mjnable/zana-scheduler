{
    "name": "mj-zana/scheduler",
    "description": "Scheduled tasks for Zana applications: cron expressions, a scope per run, overlap locks and schedule:run",
    "type": "library",
    "keywords": ["zana", "scheduler", "cron", "tasks"],
    "license": "MIT",
    "require": {
        "php": "^8.5",
        "mj-zana/console": "^2.2",
        "mj-zana/core": "^2.2",
        "psr/log": "^3.0",
        "psr/simple-cache": "^3.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "Zana\\Scheduler\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Zana\\Scheduler\\Tests\\": "tests/"
        }
    },
    "repositories": [
        { "type": "path", "url": "../zana-container", "options": { "symlink": true, "versions": { "mj-zana/container": "2.3.0" } } },
        { "type": "path", "url": "../zana-configuration", "options": { "symlink": true, "versions": { "mj-zana/configuration": "2.3.0" } } },
        { "type": "path", "url": "../zana-core", "options": { "symlink": true, "versions": { "mj-zana/core": "2.3.0" } } },
        { "type": "path", "url": "../zana-console", "options": { "symlink": true, "versions": { "mj-zana/console": "2.3.0" } } }
    ],
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=1G"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
